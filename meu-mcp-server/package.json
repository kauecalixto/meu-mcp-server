{
  "name": "calixto-secret-scanner-mcp",
  "version": "1.0.0",
  "description": "MCP server (stdio) that reports where secrets appear in a workspace file, without ever returning the secret.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.14.0" },
  "main": "build/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node build/index.js",
    "test": "vitest run",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
